# Server Configuration
PORT=3000
NODE_ENV=development

# LLM Configuration
# Options: mock | gemini | openrouter
LLM_PROVIDER=mock
LLM_TIMEOUT_MS=60000

# Gemini Provider Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter Provider Settings (OpenAI-compatible Chat Completions API, free-tier models supported)
# Base URL defaults to the OpenRouter API; point it at a local gateway (e.g. OmniRoute) if desired.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Automatic Quota Fallback (true = automatically fall back to mock on 429 / quota exhaustion)
ENABLE_LLM_FALLBACK=true

# Database Configuration
DATABASE_PATH=./dev.sqlite

# Frontend Configuration (optional, defaults to relative / for Vite proxy)
VITE_API_BASE_URL=
