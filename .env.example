# Server Configuration
PORT=3000
NODE_ENV=development

# LLM Configuration
# Options: mock | gemini | groq
LLM_PROVIDER=mock

# Real LLM API Keys (optional for Milestone 01, required only when LLM_PROVIDER is not mock)
GEMINI_API_KEY=
GROQ_API_KEY=

# Database Configuration (future milestones)
DATABASE_PATH=./dev.sqlite

# Frontend Configuration (optional, defaults to relative / for Vite proxy)
VITE_API_BASE_URL=

